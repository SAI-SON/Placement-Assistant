# Google Gemini AI API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to googleai/gemini-3.5-flash-lite with auto-failover)
GEMINI_MODEL=googleai/gemini-3.5-flash-lite

# Optional: Job News & YouTube Video Search APIs
NEWS_API_KEY=your_news_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
